{
	"name": "sveltebrush",
	"version": "0.1.0",
	"description": "Ink-brush painting and animated East Asian calligraphy on a canvas, for Svelte 5.",
	"license": "MIT",
	"author": "Heewon",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shelost/sveltebrush.git",
		"directory": "packages/svelte"
	},
	"homepage": "https://github.com/shelost/sveltebrush#readme",
	"bugs": "https://github.com/shelost/sveltebrush/issues",
	"keywords": [
		"svelte",
		"svelte5",
		"canvas",
		"brush",
		"ink",
		"calligraphy",
		"hangul",
		"hanzi",
		"drawing",
		"threlte",
		"three"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./3d": {
			"types": "./dist/3d/index.d.ts",
			"svelte": "./dist/3d/index.js",
			"default": "./dist/3d/index.js"
		},
		"./paper.css": "./dist/ui/paper.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "svelte-package -i src/lib -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json --threshold error"
	},
	"dependencies": {
		"@sveltebrush/core": "^0.1.0"
	},
	"peerDependencies": {
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.0",
		"svelte": "^5.0.0",
		"three": ">=0.172"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.0",
		"@types/three": "^0.186.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"three": "^0.186.1",
		"vite": "^8.3.3"
	},
	"peerDependenciesMeta": {
		"@threlte/core": {
			"optional": true
		},
		"@threlte/extras": {
			"optional": true
		},
		"three": {
			"optional": true
		}
	}
}
